#!/usr/bin/env sh
# Check the actual pushed tree and new history, not the mutable checkout.
set -eu
if command -v python >/dev/null 2>&1; then
  runner=python
else
  runner=python3
fi
zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero" ] && continue
  "$runner" Firmware/tools/check_publication.py --revision "$local_oid"
  if [ "$remote_oid" = "$zero" ]; then
    "$runner" Firmware/tools/check_publication.py --range "$local_oid" --exclude-remotes
  else
    "$runner" Firmware/tools/check_publication.py --range "$remote_oid..$local_oid"
  fi
done
